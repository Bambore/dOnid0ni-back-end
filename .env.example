# ═══════════════════════════════════════════════════════════
#  Doni-Doni — Variables d'environnement du déploiement
# ═══════════════════════════════════════════════════════════
# Copier ce fichier en `.env` sur le serveur, puis remplacer TOUTES les
# valeurs marquées « à-changer ». Le fichier `.env` n'est pas versionné.
#
#   cp .env.example .env && chmod 600 .env
#
# Générer un secret solide :  openssl rand -base64 32

# ── Ports publiés ──────────────────────────────────────────
# L'application mobile cible le port 8181 par défaut.
API_PORT=8181
KEYCLOAK_PORT=8080

# ── Profil Spring ──────────────────────────────────────────
# `prod` active l'envoi réel des SMS (Twilio) et coupe les logs SQL.
#
# TEMPORAIRE : tant que le compte Twilio n'est pas ouvert, laisser `dev`.
# Conséquence assumée — les codes OTP ne sont pas envoyés par SMS, ils
# sont seulement écrits dans les logs du conteneur : la connexion par
# téléphone reste inutilisable pour un vrai utilisateur, seule la
# connexion Google fonctionne.
# Repasser à `prod` dès que les trois variables TWILIO_* sont renseignées.
SPRING_PROFILES_ACTIVE=dev

# ── Base de données applicative ────────────────────────────
APP_DB_NAME=donidoni
APP_DB_USER=donidoni
APP_DB_PASSWORD=à-changer

# ── Base de données Keycloak ───────────────────────────────
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=à-changer

# ── Keycloak ───────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=à-changer
KEYCLOAK_REALM=doni-doni
KEYCLOAK_CLIENT_ID=doni-doni-backend
# Secret du client confidentiel `doni-doni-backend` (console Keycloak).
KEYCLOAK_CLIENT_SECRET=à-changer

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=à-changer

# ── MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=à-changer
MINIO_ROOT_PASSWORD=à-changer

# ── Twilio (obligatoire avec le profil prod) ───────────────
# Sans ces trois valeurs, l'API refuse de démarrer en profil `prod` :
# aucun code OTP ne partirait et personne ne pourrait se connecter.
# Inutilisées tant que SPRING_PROFILES_ACTIVE=dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Google Sign-In ─────────────────────────────────────────
# Identifiant du client **Web**, celui déclaré par l'application mobile :
# il sert d'audience à la vérification des jetons Google. Sans lui, la
# valeur par défaut est un placeholder et toute connexion Google échoue.
# Un identifiant client OAuth n'est pas un secret.
GOOGLE_CLIENT_ID=434153761759-ftmqtq1p6c8s0dscqb8n7d9tcen2rhv9.apps.googleusercontent.com

# ── Version d'image (renseignée par le pipeline) ───────────
APP_VERSION=latest
