# ═══════════════════════════════════════════════════════════
#  Doni-Doni — Variables d'environnement du déploiement
# ═══════════════════════════════════════════════════════════
# Copier ce fichier en `.env` sur le serveur, puis remplacer TOUTES les
# valeurs marquées « à-changer ». Le fichier `.env` n'est pas versionné.
#
#   cp .env.example .env && chmod 600 .env
#
# Générer un secret solide :  openssl rand -base64 32

# ── Ports publiés ──────────────────────────────────────────
# L'application mobile cible le port 8181 par défaut.
API_PORT=8181
KEYCLOAK_PORT=8080

# ── Profil Spring ──────────────────────────────────────────
# `prod` active l'envoi réel des SMS (Twilio) et coupe les logs SQL.
# Ne repasser à `dev` que sur un poste de développement.
SPRING_PROFILES_ACTIVE=prod

# ── Base de données applicative ────────────────────────────
APP_DB_NAME=donidoni
APP_DB_USER=donidoni
APP_DB_PASSWORD=à-changer

# ── Base de données Keycloak ───────────────────────────────
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=à-changer

# ── Keycloak ───────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=à-changer
KEYCLOAK_REALM=doni-doni
KEYCLOAK_CLIENT_ID=doni-doni-backend
# Secret du client confidentiel `doni-doni-backend` (console Keycloak).
KEYCLOAK_CLIENT_SECRET=à-changer

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=à-changer

# ── MinIO ──────────────────────────────────────────────────
MINIO_ROOT_USER=à-changer
MINIO_ROOT_PASSWORD=à-changer

# ── Twilio (obligatoire avec le profil prod) ───────────────
# Sans ces trois valeurs, l'API refuse de démarrer : aucun code OTP ne
# pourrait être envoyé et personne ne pourrait se connecter.
TWILIO_ACCOUNT_SID=à-changer
TWILIO_AUTH_TOKEN=à-changer
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Google Sign-In ─────────────────────────────────────────
# Identifiant du client **Web** (celui utilisé par l'application mobile).
GOOGLE_CLIENT_ID=

# ── Version d'image (renseignée par le pipeline) ───────────
APP_VERSION=latest
